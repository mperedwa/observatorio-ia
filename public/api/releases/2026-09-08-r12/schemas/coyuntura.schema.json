{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://observatorioia.org/api/schemas/coyuntura.schema.json",
  "title": "Coyuntura / Current affairs",
  "description": "Schema de la respuesta pública completa; el campo data también se publica por separado. / Full public-response schema; the data field schema is also published separately.",
  "type": "object",
  "required": [
    "version",
    "lastUpdate",
    "count",
    "source",
    "license",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "lastUpdate": {
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "const": "https://observatorioia.org"
    },
    "license": {
      "const": "CC BY 4.0"
    },
    "data": {
      "$ref": "#/definitions/_dataset"
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "required": [
        "es",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fuente": {
      "type": "object",
      "required": [
        "url",
        "descripcion"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "descripcion": {
          "$ref": "#/definitions/bilingual"
        },
        "nombre": {
          "$ref": "#/definitions/bilingual"
        }
      }
    },
    "_dataset": {
      "title": "Notas de coyuntura",
      "description": "Contexto editorial fechado y trazable que no sustituye el estado oficial de los expedientes.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fecha",
          "etiqueta",
          "titulo",
          "texto",
          "fuentes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "etiqueta": {
            "$ref": "#/definitions/bilingual"
          },
          "titulo": {
            "$ref": "#/definitions/bilingual"
          },
          "texto": {
            "$ref": "#/definitions/bilingual"
          },
          "implicacion": {
            "$ref": "#/definitions/bilingual"
          },
          "fuentes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/fuente"
            }
          }
        }
      }
    }
  },
  "x-observatorio-data-schema": "/api/schemas/coyuntura-data.schema.json"
}