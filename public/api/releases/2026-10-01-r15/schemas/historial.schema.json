{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://observatorioia.org/api/schemas/historial.schema.json",
  "title": "Historial editorial / Editorial history",
  "description": "Schema de la respuesta pública completa; el campo data también se publica por separado. / Full public-response schema; the data field schema is also published separately.",
  "type": "object",
  "required": [
    "version",
    "lastUpdate",
    "count",
    "source",
    "license",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "lastUpdate": {
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "const": "https://observatorioia.org"
    },
    "license": {
      "const": "CC BY 4.0"
    },
    "data": {
      "$ref": "#/definitions/_dataset"
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "required": [
        "es",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "_dataset": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fecha",
          "tipo",
          "actualizacion",
          "fuente"
        ],
        "additionalProperties": false,
        "properties": {
          "fecha": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "tipo": {
            "enum": [
              "legislacion",
              "institucion",
              "indicador",
              "proyecto",
              "recurso"
            ]
          },
          "actualizacion": {
            "$ref": "#/definitions/bilingual"
          },
          "fuente": {
            "$ref": "#/definitions/bilingual"
          },
          "fuente_url": {
            "type": "string",
            "format": "uri"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{7,40}$"
          }
        }
      }
    }
  },
  "x-observatorio-data-schema": "/api/schemas/historial-data.schema.json"
}