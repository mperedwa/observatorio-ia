{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "coyuntura.schema.json",
  "title": "Notas de coyuntura",
  "description": "Contexto editorial fechado y trazable que no sustituye el estado oficial de los expedientes.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "fecha", "etiqueta", "titulo", "texto", "fuentes"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "fecha": { "type": "string", "format": "date" },
      "etiqueta": { "$ref": "#/definitions/bilingual" },
      "titulo": { "$ref": "#/definitions/bilingual" },
      "texto": { "$ref": "#/definitions/bilingual" },
      "implicacion": { "$ref": "#/definitions/bilingual" },
      "fuentes": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/definitions/fuente" }
      }
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "required": ["es", "en"],
      "additionalProperties": false,
      "properties": {
        "es": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "fuente": {
      "type": "object",
      "required": ["url", "descripcion"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "descripcion": { "$ref": "#/definitions/bilingual" },
        "nombre": { "$ref": "#/definitions/bilingual" }
      }
    }
  }
}
