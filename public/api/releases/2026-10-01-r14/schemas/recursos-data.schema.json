{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recursos.schema.json",
  "title": "Directorio público de recursos",
  "description": "Documentos, normas, indicadores y fuentes utilizados por el Observatorio IA Costa Rica.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "titulo", "fuente", "url", "tipo", "tipoFuente"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "titulo": { "$ref": "#/definitions/bilingual" },
      "fuente": { "type": "string", "minLength": 1 },
      "url": { "type": "string", "format": "uri" },
      "tipo": { "$ref": "#/definitions/bilingual" },
      "tipoFuente": {
        "enum": ["primaria-oficial", "acceso-informacion", "multilateral", "academica", "prensa", "otra-secundaria"]
      },
      "nota": { "$ref": "#/definitions/bilingual" }
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "required": ["es", "en"],
      "additionalProperties": false,
      "properties": {
        "es": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  }
}
