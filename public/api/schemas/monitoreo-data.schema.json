{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "monitoreo.schema.json",
  "type": "object",
  "required": ["schemaVersion", "fechaCorte", "politica", "frentes", "revisiones"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "fechaCorte": { "type": "string", "format": "date" },
    "politica": {
      "type": "object",
      "required": ["descripcion", "automatizacion", "cadencias"],
      "additionalProperties": false,
      "properties": {
        "descripcion": { "$ref": "#/definitions/bilingual" },
        "automatizacion": { "$ref": "#/definitions/bilingual" },
        "cadencias": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/cadencia" }
        }
      }
    },
    "frentes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/frente" }
    },
    "revisiones": {
      "type": "array",
      "items": { "$ref": "#/definitions/revision" }
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "required": ["es", "en"],
      "additionalProperties": false,
      "properties": {
        "es": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "cadenciaId": {
      "type": "string",
      "enum": ["semanal", "mensual", "trimestral", "semestral"]
    },
    "cadencia": {
      "type": "object",
      "required": ["id", "dias", "diasAnticipacionHabiles", "nombre", "aplicaA"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/cadenciaId" },
        "dias": { "type": "integer", "minimum": 1 },
        "diasAnticipacionHabiles": { "type": "integer", "minimum": 0, "maximum": 30 },
        "nombre": { "$ref": "#/definitions/bilingual" },
        "aplicaA": { "$ref": "#/definitions/bilingual" }
      }
    },
    "frente": {
      "type": "object",
      "required": [
        "id",
        "ambito",
        "metrica",
        "nombre",
        "descripcion",
        "cadenciaId",
        "fechaUltimaRevision",
        "fechaProximaRevision",
        "alcance",
        "fuenteUrl"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "ambito": {
          "type": "string",
          "enum": ["catalogo", "enia", "legislacion", "marco-pais", "indicador"]
        },
        "metrica": {
          "type": "string",
          "enum": [
            "legislacion-expedientes",
            "enia-intervenciones-unicas",
            "catalogo-seguimiento",
            "catalogo-verificado",
            "catalogo-ecosistema",
            "marco-pais-instrumentos",
            "indicador-ilia",
            "indicador-oecd"
          ]
        },
        "nombre": { "$ref": "#/definitions/bilingual" },
        "descripcion": { "$ref": "#/definitions/bilingual" },
        "cadenciaId": { "$ref": "#/definitions/cadenciaId" },
        "notaCadencia": { "$ref": "#/definitions/bilingual" },
        "fechaUltimaRevision": { "type": "string", "format": "date" },
        "fechaProximaRevision": { "type": "string", "format": "date" },
        "alcance": {
          "type": "object",
          "required": ["cantidad", "unidad"],
          "additionalProperties": false,
          "properties": {
            "cantidad": { "type": "integer", "minimum": 1 },
            "unidad": { "$ref": "#/definitions/bilingual" }
          }
        },
        "fuenteUrl": { "type": "string", "format": "uri" }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "id",
        "fecha",
        "frenteId",
        "resultado",
        "resumen",
        "fuenteUrl",
        "transiciones"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "fecha": { "type": "string", "format": "date" },
        "frenteId": { "$ref": "#/definitions/id" },
        "resultado": {
          "type": "string",
          "enum": ["cambio-detectado", "cambio-publicado", "sin-cambios"]
        },
        "resumen": { "$ref": "#/definitions/bilingual" },
        "fuenteUrl": { "type": "string", "format": "uri" },
        "issueUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/mperedwa/observatorio-ia/issues/[0-9]+$"
        },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "transiciones": {
          "type": "array",
          "items": { "$ref": "#/definitions/transicion" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "resultado": { "const": "sin-cambios" } },
            "required": ["resultado"]
          },
          "then": {
            "properties": { "transiciones": { "maxItems": 0 } }
          },
          "else": {
            "properties": { "transiciones": { "minItems": 1 } }
          }
        }
      ]
    },
    "transicion": {
      "type": "object",
      "required": ["objetoTipo", "objetoId", "campo", "antes", "despues"],
      "additionalProperties": false,
      "properties": {
        "objetoTipo": {
          "type": "string",
          "enum": ["proyecto", "intervencion-enia", "expediente", "instrumento", "indicador"]
        },
        "objetoId": { "type": "string", "minLength": 1 },
        "campo": { "type": "string", "minLength": 1 },
        "antes": { "type": ["string", "null"] },
        "despues": { "type": ["string", "null"] }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    }
  }
}
